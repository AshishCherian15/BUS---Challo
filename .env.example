# Copy this file to .env and fill in your own Supabase project values.
# Found in Supabase Dashboard -> Project Settings -> API.

# Your project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# The "anon / public" key — safe to expose to the browser, protected by Row Level Security.
SUPABASE_ANON_KEY=

# Port the Node server listens on (optional)
PORT=3000
